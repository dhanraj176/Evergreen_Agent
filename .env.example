# Copy to .env and fill in. Never commit .env.

# Patch model: liquid (default: LFM2.5-8B-A1B on a local llama-server) | openai | anthropic
LLM_PROVIDER=liquid
PATCH_SERVER_URL=http://127.0.0.1:8081
# Only for LLM_PROVIDER=openai or anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# Nimble: live migration notes / GitHub issues
NIMBLE_API_KEY=

# RawTree (HTTP API): the agent's memory
RAWTREE_API_KEY=
RAWTREE_DATABASE=evergreen

# Liquid LFM2.5-1.2B on llama-server: rule matching
LLAMA_SERVER_URL=http://127.0.0.1:8080

# GitHub: run `gh auth login` once
