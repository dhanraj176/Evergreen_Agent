# Copy to .env and fill in. Never commit .env.

# Patch model: openai or anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# Nimble: live migration notes / GitHub issues
NIMBLE_API_KEY=

# RawTree (HTTP API): the agent's memory
RAWTREE_API_KEY=
RAWTREE_DATABASE=evergreen

# Liquid LFM2.5 on llama-server
LLAMA_SERVER_URL=http://localhost:8080

# GitHub: run `gh auth login` once
